  margin: 0.25rem 0 1rem;
  letter-spacing: 0.02em;
  text-shadow: 0 2px 14px rgba(0, 0, 0, 0.3);
}

/* Ucapan terima kasih — opsional, sedikit lebih kecil dari nama */
.closing-thanks {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.75;
  text-shadow: 0 1px 8px rgba(0, 0, 0, 0.2);
  max-width: 28rem;
  margin: 0 auto;
}

.site-footer {
  background: var(--panel-soft);
  padding: 2.25rem 1.5rem 2.5rem; /* sedikit lebih tinggi */
  text-align: center;
  font-size: 11px;
  color: #7A736C;
  letter-spacing: 0.05em;
}

    /* Audio */
    .audio-btn {
      position: fixed; bottom: 22px; right: 22px; z-index: 60;
      width: 46px; height: 46px; border-radius: 50%;
      background: rgba(30,30,30,0.82); color: white; border: none;
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 4px 18px rgba(0,0,0,0.18); cursor: pointer;
      transition: transform 0.3s;
    }
    .audio-btn:hover { transform: scale(1.08); }
    .hidden { display: none !important; }
  </style>
</head>
<body data-wedding-date={w.datetime}>

  <!-- ==================== COVER – SPLIT SCREEN ==================== -->
<div id="cover">
  <!-- LEFT PANEL -->
  <div class="cover-panel cover-left">
    <div class="panel-bg" style={`background-image:url('${w.photos.coverLeft}')`}></div>
    <div class="panel-overlay"></div>
    <div class="panel-content">
      <p class="label">{w.cover.label}</p>
      <h1>{w.couple.short}</h1>
      <p class="date">{w.dateLabel}</p>
    </div>
  </div>

  <!-- RIGHT PANEL -->
  <div class="cover-panel cover-right">
    <div class="panel-bg" style={`background-image:url('${w.photos.coverRight}')`}></div>
    <div class="panel-overlay"></div>
    <div class="panel-content">
      <p class="label">{w.cover.label}</p>
      <h1>{w.couple.short}</h1>
      <p class="guest-label">Kepada Yth.</p>
      <p class="guest-name" id="guestName">{w.cover.guestFallback}</p>
      <button id="openBtn" class="btn-open">{w.cover.openButton}</button>
    </div>
  </div>
</div>

  <!-- ==================== MAIN ==================== -->
  <div id="main-content">
   <div class="main-left">
    <div class="bg" style={`background-image: url('${w.photos.mainSticky}');`}></div>
    </div>
   <div class="main-right">

    <!-- HERO + COUNTDOWN -->
    <section class="hero">
      <div class="hero-slide-track" id="heroTrack">
        {w.photos.hero.map((src) => (
          <div class="hero-bg" style={`background-image:url('${src}')`}></div>
        ))}
      </div>
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <p class="label aos fade-down">The Wedding of</p>
        <h2 class="heading aos fade-up" style="font-size:clamp(2.2rem,6vw,3.2rem);margin-bottom:0.4rem">{w.couple.short}</h2>
        <div class="countdown aos fade-up d2">
          <div class="cd-item"><div class="cd-num" id="days">00</div><div class="cd-label">Days</div></div>
          <div class="cd-item"><div class="cd-num" id="hours">00</div><div class="cd-label">Hours</div></div>
          <div class="cd-item"><div class="cd-num" id="minutes">00</div><div class="cd-label">Minutes</div></div>
          <div class="cd-item"><div class="cd-num" id="seconds">00</div><div class="cd-label">Seconds</div></div>
        </div>
      </div>
    </section>

    <!-- SALAM -->
    <section class="section text-center salam-section">
      <div class="container">
        <h3 class="heading aos fade-down">{w.salam.heading}</h3>
        <p class="body-text aos fade-up">{w.salam.body}</p>
      </div>

      <!-- Circular carousel: 4 visible, step every 1.5s -->
      <div class="circle-carousel aos fade-in">
        <div class="circle-carousel-track" id="circleTrack">
          {w.photos.circle.map((src) => (
            <img src={src} alt="" />
          ))}
        </div>
      </div>
    </section>

    <!-- BRIDE & GROOM -->
    <section class="section bride-groom-section">
      <div class="container" style="max-width:420px">
        <h3 class="heading text-center aos fade-down bride-groom-title">Bride & Groom</h3>

        <!-- THE BRIDE -->
        <div class="person-block aos fade-right">
          <div class="person-photo-row">
            <div class="person-photo" data-slider="bride">
              <div class="slide-track">
                {w.photos.bride.map((src, i) => (
                  <img src={src} alt={`Bride ${i + 1}`} />
                ))}
              </div>
            </div>
            <span class="person-label bride-label anim-from-right">The Bride</span>
          </div>
          <h4 class="person-name anim-from-bottom">{w.couple.bride.fullName}</h4>
          <p class="person-parents anim-from-bottom delay-1">
            {parentsBride.map((line) => (
              <>{line}<br /></>
            ))}
          </p>
          <a href={w.couple.bride.instagramUrl} class="ig-btn anim-from-bottom delay-2" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            {w.couple.bride.instagram}
          </a>
        </div>

        <p class="person-and aos fade-in">and</p>

        <!-- THE GROOM -->
        <div class="person-block aos fade-left">
          <div class="person-photo-row groom-row">
            <span class="person-label groom-label anim-from-left">The Groom</span>
            <div class="person-photo" data-slider="groom">
              <div class="slide-track">
                {w.photos.groom.map((src, i) => (
                  <img src={src} alt={`Groom ${i + 1}`} />
                ))}
              </div>
            </div>
          </div>
          <h4 class="person-name anim-from-bottom">{w.couple.groom.fullName}</h4>
          <p class="person-parents anim-from-bottom delay-1">
            {parentsGroom.map((line) => (
              <>{line}<br /></>
            ))}
          </p>
          <a href={w.couple.groom.instagramUrl} class="ig-btn anim-from-bottom delay-2" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            {w.couple.groom.instagram}
          </a>
        </div>

      </div>
    </section>

    <!-- QUOTE BAND -->
    <section class="quote-band">
      <p class="quote-text aos fade-up">"{w.quote.text}"</p>
      <p class="quote-source aos fade-up">{w.quote.source}</p>
    </section>

    <!-- SAVE THE DATE + WEDDING EVENT (satu background) -->
<div class="std-we-wrap">
  <!-- Background foto -->
 <div class="std-slide-track" id="stdTrack">
  {w.photos.stdBg.map((src) => (
    <div class="std-bg" style={`background-image:url('${src}')`}></div>
  ))}
 </div>
  <div class="std-overlay"></div>

<!-- SAVE THE DATE -->
  <section class="std-section">
   <div class="std-content">
    <h3 class="heading aos fade-down" style="font-style:italic">Save the Date</h3>
      <div class="std-photos">
        <div class="std-photo left">
          <img src={w.photos.std[0]} alt="Couple 1" />
        </div>
        <div class="std-photo right">
          <img src={w.photos.std[1]} alt="Couple 2" />
        </div>
      </div>
   </div>
  </section>

    <!-- WEDDING EVENT -->
    <div class="we-section">
      <div class="we-inner">
        <div class="we-label-col">
          <span class="we-label-text">Wedding Event</span>
        </div>
        <div class="we-content">
          {w.events.map((ev) => (
            <div class="we-event">
              <p class="label">{ev.label}</p>
              {ev.title && <h4 class="event-title">{ev.title}</h4>}
              {ev.time && <p class="event-time">{ev.time}</p>}
              <p class="event-loc">
                {ev.location.split('\n').map((line) => (
                  <>{line}<br /></>
                ))}
              </p>
              {ev.mapsUrl && (
                <a href={ev.mapsUrl} target="_blank" rel="noopener" class="btn">Buka Maps</a>
              )}
              {'streamingUrl' in ev && ev.streamingUrl && (
                <a href={ev.streamingUrl} target="_blank" rel="noopener" class="btn">Live Streaming</a>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
</div><!-- end std-we-wrap -->

    <!-- RSVP (format yang sama seperti sebelum ubahan gallery) -->
    <section class="section rsvp-section text-center">
      <div class="container" style="max-width:400px">
        <h3 class="heading aos fade-down">{w.rsvp.heading}</h3>
        <p class="body-text aos fade-up" style="margin-bottom:1.5rem">{w.rsvp.body}</p>

        <iframe data-tally-src={w.rsvp.tallyEmbed} loading="lazy" width="100%" height="240" frameborder="0" marginheight="0" marginwidth="0" title="RSVP"></iframe>
        <script is:inline>var d=document,w="https://tally.so/widgets/embed.js",v=function(){"undefined"!=typeof Tally?Tally.loadEmbeds():d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach((function(e){e.src=e.dataset.tallySrc}))};if("undefined"!=typeof Tally)v();else if(d.querySelector('script[src="'+w+'"]')==null){var s=d.createElement("script");s.src=w,s.onload=v,s.onerror=v,d.body.appendChild(s);}</script>

        <p id="rsvpSuccess" class="hidden" style="margin-top:1rem;color:var(--accent);font-size:14px">Terima kasih, konfirmasi Anda telah diterima.</p>
      </div>
    </section>

<!-- OUR STORY -->
<div class="story-wrap">
  <!-- Background sliding -->
  <div class="story-slide-track" id="storyTrack">
    {w.photos.storyBg.map((src) => (
      <div class="story-bg" style={`background-image:url('${src}')`}></div>
    ))}
  </div>
  <div class="std-overlay"></div>

  <section class="story-section">
    <div class="std-content">
      <h3 class="heading aos fade-down" style="font-style:italic">Our Story</h3>

      <!-- 1 foto -->
      <div class="story-photos">
         <div class="story-photos-inner">
  <div class="story-photo-track" id="storyPhotoTrack">
    {w.photos.story.map((src, i) => (
      <div class="story-photo">
        <img src={src} alt={`Story ${i + 1}`} />
      </div>
    ))}
  </div>
         </div>
      </div>
    </div>

    <!-- Timeline + label kanan -->
    <div class="story-inner">
      <div class="story-content">
        {w.story.items.map((item) => (
          <div class="story-item">
            <p class="label">{item.date}</p>
            <h4 class="event-title">{item.title}</h4>
            <p class="event-loc">{item.body}</p>
          </div>
        ))}
      </div>

      <div class="story-label-col">
        <span class="story-label-text">Love Story</span>
      </div>
    </div>
  </section>
</div>
      
<!-- GALLERY -->
<section class="section bg-section text-center">
  <div class="container-lg" style="padding-left:0;padding-right:0;">
    <h3 class="heading aos fade-down" style="padding:0 1.25rem;">Our Gallery</h3>

    <div class="gal">
      <!-- Foto besar -->
      <div class="gal-main">
        <img
          id="galMain"
          src={w.photos.gallery[0]}
          alt="Gallery"
        />
      </div>

      <!-- Strip foto kecil -->
      <div class="gal-strip" id="galStrip">
        <div class="gal-track" id="galTrack">
          {w.photos.gallery.map((src, i) => (
            <button type="button" class:list={['gal-thumb', { 'is-active': i === 0 }]} data-full={src}>
              <img src={src} alt="" />
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- UCAPAN DOA RESTU -->
<section class="ucapan-section">
  <div class="ucapan-container">
    <h3 class="ucapan-heading aos fade-down">{w.ucapan.heading}</h3>
    <p class="ucapan-desc">{w.ucapan.body}</p>

    <!-- FORM -->
    <form id="wishForm" class="ucapan-form">
      <input
        type="text"
        id="wishName"
        class="form-input"
        placeholder="Nama Anda"
        required
        maxlength="60"
        autocomplete="name"
      />
      <textarea
        id="wishMessage"
        class="form-input"
        placeholder="Tulis doa & ucapan..."
        required
        maxlength="500"
      ></textarea>
      <button type="submit" class="ucapan-btn">Kirim Ucapan</button>
      <p id="wishStatus" class="ucapan-status"></p>
    </form>

    <!-- DAFTAR UCAPAN -->
    <div id="wishList" class="wish-list">
      <p style="text-align:center;color:#7A736C;font-size:14px;">Memuat ucapan...</p>
    </div>
  </div>
</section>

<!-- GIFT -->
<section class="section gift-section text-center">
  <div class="gift-container">
    <div class="gift-intro">
      <h3 class="heading aos fade-down">{w.gift.heading}</h3>
      <p class="body-text aos fade-up">{w.gift.body}</p>
    </div>

    <div class="gift-cards">
      <!-- Transfer Bank -->
{w.gift.bank.map((b, i) => (
  <div class="gift-card aos fade-up d2">
    <div class="gift-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M4 10v7h3v-7H4zm6 0v7h3v-7h-3zM2 19h20v2H2v-2zm14-9v7h3v-7h-3zm-4.5-9L2 6v2h20V6l-9.5-5z"/></svg>
    </div>
    <p class="gift-label">{b.label}</p>
    <p class="gift-bank">{b.bankName}</p>
    <p class="gift-number" id={`giftRek-${i}`}>{b.number}</p>
    <p class="gift-name">{b.holder}</p>
    <button type="button" class="gift-btn" data-copy={b.numberCopy}>
      <svg viewBox="0 0 24 24"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg>
      Salin Rekening
    </button>
  </div>
))}

      <!-- Alamat -->
      <div class="gift-card aos fade-up d3">
        <div class="gift-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/></svg>
        </div>
        <p class="gift-label">{w.gift.address.label}</p>
        <p class="gift-name">{w.gift.address.name}</p>
        <p class="gift-address" id="giftAlamat">
          {giftLines.map((line) => (
            <>{line}<br /></>
          ))}
        </p>
        <button
          type="button"
          class="gift-btn"
          data-copy={w.gift.address.copy}
        >
          <svg viewBox="0 0 24 24"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg>
          Salin Alamat
        </button>
      </div>
    </div>
  </div>
</section>

<!-- CLOSING -->
<section class="closing">
  <div class="closing-slide-track" id="closingTrack">
    {w.photos.closing.map((src) => (
      <div class="closing-bg" style={`background-image:url('${src}')`}></div>
    ))}
  </div>

  <div class="closing-overlay"></div>

  <div class="closing-content">
    <p class="closing-label aos fade-up">{w.closing.label}</p>
    <h4 class="closing-names aos fade-up d2">{w.couple.short}</h4>
    <p class="closing-thanks aos fade-up d3">{w.closing.thanks}</p>
  </div>
</section>

<footer class="site-footer">
  {w.meta.footer}
</footer>
   </div>
  </div>

  <!-- Audio -->
  <button id="audioBtn" class="audio-btn" aria-label="Toggle music">
    <svg id="iconPlay" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
    <svg id="iconPause" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
  </button>
  <audio id="bgm" loop preload="none">
    <source src={w.music} type="audio/mpeg" />
  </audio>

 <script is:inline define:vars={{ supabaseUrl: w.supabase.url, supabaseAnonKey: w.supabase.anonKey }}>
  window.__WEDDING_CONFIG__ = { supabaseUrl, supabaseAnonKey };
</script>
<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
  import '../scripts/main.js';
</script>
</body>
</html>