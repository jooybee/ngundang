/* ========== GALLERY ========== */
.gal {
  max-width: 100%;
  margin: 0 auto;
  padding: 0 0; /* sama Our Story & Save the Date */
  box-sizing: border-box;
}

.gal-main {
  width: 100%;
  aspect-ratio: 3 / 5;
  border-radius: 10px;
  overflow: hidden;
  background: #e8e2d9;
  margin-bottom: 12px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.08);
}

.gal-main img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: opacity 0.35s ease;
}

.gal-main img.is-fading {
  opacity: 0.35;
}

/* Viewport strip: kiri-kanan terpotong (separuh foto) */
.gal-strip {
  width: 100%;
  overflow: hidden;
  touch-action: pan-y;
  -webkit-user-select: none;
  user-select: none;
}

.gal-track {
  display: flex;
  gap: 10px;
  width: max-content;
  will-change: transform;
}

.gal-thumb {
  flex: 0 0 auto;
  width: 78px;
  height: 78px;
  border: 0;
  padding: 0;
  margin: 0;
  border-radius: 8px;
  overflow: hidden;
  cursor: pointer;
  background: #ddd;
  opacity: 0.55;
  transform: scale(0.92);
  transition: opacity 0.25s ease, transform 0.25s ease;
  -webkit-tap-highlight-color: transparent;
}

.gal-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  pointer-events: none;
}

.gal-thumb.is-active {
  opacity: 1;
  transform: scale(1);
}

@media (min-width: 480px) {
  .gal-thumb {
    width: 92px;
    height: 92px;
  }
}

