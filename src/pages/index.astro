/* Overlay lebih tipis → foto lebih kelihatan */
.std-we-wrap > .std-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.3) 0%,
    rgba(255, 255, 255, 0.45) 50%,
    rgba(255, 255, 255, 0.6) 100%
  );
  pointer-events: none;
}

/* Overlay putih transparan (mirip hero) */
.std-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.55) 0%,
