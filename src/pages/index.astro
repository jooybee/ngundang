  </button>
  <audio id="bgm" loop preload="none">
    <source src="https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf07a.mp3?filename=soft-background-music-116010.mp3" type="audio/mpeg" />
  </audio>

  <script is:inline>
    // Cover open
    const cover = document.getElementById('cover');
    const main = document.getElementById('main-content');
    const bgm = document.getElementById('bgm');
    let isPlaying = false;

    document.getElementById('openBtn').addEventListener('click', () => {
      cover.classList.add('hidden');
      main.classList.add('visible');
      bgm.play().then(() => { isPlaying = true; updateIcon(); }).catch(()=>{});
      setTimeout(observe, 350);
    });

    // Audio
    const iconPlay = document.getElementById('iconPlay');
    const iconPause = document.getElementById('iconPause');
    function updateIcon() {
      iconPlay.classList.toggle('hidden', isPlaying);
      iconPause.classList.toggle('hidden', !isPlaying);
    }
    document.getElementById('audioBtn').addEventListener('click', () => {
      if (isPlaying) { bgm.pause(); isPlaying = false; }
      else { bgm.play(); isPlaying = true; }
      updateIcon();
    });

    // Countdown
    const target = new Date('2027-06-11T08:00:00+07:00').getTime();
    function tick() {
      const d = target - Date.now();
      if (d < 0) return;
      document.getElementById('days').textContent = String(Math.floor(d/86400000)).padStart(2,'0');
      document.getElementById('hours').textContent = String(Math.floor((d%86400000)/3600000)).padStart(2,'0');
      document.getElementById('minutes').textContent = String(Math.floor((d%3600000)/60000)).padStart(2,'0');
      document.getElementById('seconds').textContent = String(Math.floor((d%60000)/1000)).padStart(2,'0');
    }
    tick(); setInterval(tick, 1000);

    // Discrete circular carousel: 4 visible, step 1 every 1.5s (smooth, not marquee)
    function startCircleCarousel() {
      const track = document.getElementById('circleTrack');
      if (!track) return;
      const imgs = track.querySelectorAll('img');
      const total = imgs.length;
      const visible = 4;
      const maxIdx = total - visible;
      let idx = 0;
      setInterval(() => {
        idx += 1;
        if (idx > maxIdx) {
          track.style.transition = 'none';
          track.style.transform = 'translateX(0)';
          void track.offsetWidth;
          track.style.transition = 'transform 1.4s cubic-bezier(0.25, 0.1, 0.25, 1)';
          idx = 0;
          return;
        }
        // step = one image width + gap (12px)
        const first = imgs[0];
        const step = first.getBoundingClientRect().width + 4;
        track.style.transform = 'translateX(-' + (idx * step) + 'px)';
      }, 4500);
    }

    // Bride slides LEFT, Groom slides RIGHT, same timing
    function startSyncedCoupleSliders(interval = 3200) {
      const brideEl = document.querySelector('[data-slider="bride"]');
      const groomEl = document.querySelector('[data-slider="groom"]');
      const bride = brideEl && brideEl.querySelector('.slide-track');
      const groom = groomEl && groomEl.querySelector('.slide-track');
      if (!bride || !groom) return;
      const nB = bride.querySelectorAll('img').length;
      const nG = groom.querySelectorAll('img').length;
      const n = Math.min(nB, nG);
      if (n < 2) return;

      // For groom to slide RIGHT: reverse image order in DOM once
      const gImgs = Array.from(groom.querySelectorAll('img'));
      gImgs.reverse().forEach(img => groom.appendChild(img));
      // start groom at last (which is original first after reverse... 
      // after reverse, index 0 is former last. We want to start showing original first.
      // After reverse, original first is at end. Set initial transform to last index.
      groom.style.transform = 'translateX(-' + ((n - 1) * 100) + '%)';

      let i = 0;
      setInterval(() => {
        i = (i + 1) % n;
        // Bride → left
        bride.style.transform = 'translateX(-' + (i * 100) + '%)';
        // Groom → right: decreasing index after reverse = content moves right
        const gIdx = (n - 1 - i);
        groom.style.transform = 'translateX(-' + (gIdx * 100) + '%)';
      }, interval);
    }

    function startSlider(containerSelector, interval = 3200) {
      const containers = document.querySelectorAll(containerSelector);
      containers.forEach(container => {
        // skip couple photos (handled by synced)
        if (container.getAttribute('data-slider') === 'bride' || container.getAttribute('data-slider') === 'groom') return;
        const track = container.querySelector('.slide-track');
        if (!track) return;
        const imgs = track.querySelectorAll('img');
        if (imgs.length < 2) return;
        let i = 0;
        setInterval(() => {
          i = (i + 1) % imgs.length;
          track.style.transform = 'translateX(-' + (i * 100) + '%)';
        }, interval);
      });
    }

    // Background slideshow (fade between .active)
    function startBgSlider(selector, interval = 4000) {
      const parents = document.querySelectorAll(selector);
      parents.forEach(parent => {
        // parent itself holds multiple .xxx-bg children
      });
      // Hero — slow horizontal slide
      const heroTrack = document.getElementById('heroTrack');
      if (heroTrack) {
        const slides = heroTrack.querySelectorAll('.hero-bg');
        const n = slides.length;
        if (n > 1) {
          let i = 0;
          setInterval(() => {
            i = (i + 1) % n;
            heroTrack.style.transform = 'translateX(-' + (i * 100) + '%)';
          }, 5500);
        }
      }
// Save the Date + Wedding Event — horizontal slide
const stdTrack = document.getElementById('stdTrack');
if (stdTrack) {
  const slides = stdTrack.querySelectorAll('.std-bg');
  const n = slides.length;
  if (n > 1) {
    let i = 0;
    setInterval(() => {
      i = (i + 1) % n;
      stdTrack.style.transform = 'translateX(-' + (i * 100) + '%)';
    }, 5000);
  }
}
      // Story
      const storyBgs = document.querySelectorAll('.story-bg');
      if (storyBgs.length > 1) {
        let i = 0;
        setInterval(() => {
          storyBgs[i].style.opacity = '0';
          i = (i + 1) % storyBgs.length;
          storyBgs[i].style.opacity = '0.28';
        }, 3800);
        storyBgs.forEach((el, idx) => { el.style.opacity = idx === 0 ? '0.28' : '0'; el.style.position = 'absolute'; el.style.inset = '0'; });
      }
      // Closing
      const closeBgs = document.querySelectorAll('.closing-bg');
      if (closeBgs.length > 1) {
        let i = 0;
        setInterval(() => {
          closeBgs[i].style.opacity = '0';
          i = (i + 1) % closeBgs.length;
          closeBgs[i].style.opacity = '0.32';
        }, 4000);
        closeBgs.forEach((el, idx) => { el.style.opacity = idx === 0 ? '0.32' : '0'; el.style.position = 'absolute'; el.style.inset = '0'; });
      }
    }

    // Start image sliders
    startCircleCarousel();
    startSyncedCoupleSliders(5000);
    startSlider('.story-photos', 5000);
    startBgSlider();

    // Scroll animations
    function observe() {
      const obs = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            e.target.classList.add('in-view');
            obs.unobserve(e.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.aos:not(.is-visible), .anim-from-right, .anim-from-left, .anim-from-bottom, .std-photo').forEach(el => obs.observe(el));
    }

    // Forms
    document.getElementById('rsvpForm')?.addEventListener('submit', e => {
      e.preventDefault();
      document.getElementById('rsvpSuccess').classList.remove('hidden');
      e.target.reset();
    });
    document.getElementById('wishForm')?.addEventListener('submit', e => {
      e.preventDefault();
      const n = e.target.name.value, w = e.target.wish.value;
      const div = document.createElement('div');
      div.className = 'wish-item';
      div.innerHTML = '<p style="font-weight:500;margin-bottom:0.25rem">'+n+'</p><p class="body-text" style="font-size:13px">'+w+'</p>';
      document.getElementById('wishesList').prepend(div);
      e.target.reset();
    });
  </script>
