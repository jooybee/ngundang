/* ===== biarkan yang di bawah ini tetap sama ===== */

.std-photos {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.4rem;
  max-width: 100%;
  margin: 0 auto;
  padding: 0 0.7rem; /* sama dengan .we-inner di bawahnya */
  width: 100%;
  box-sizing: border-box;
  overflow: visible;
}

.std-photo {
  overflow: hidden;
  aspect-ratio: 8 / 5;
  background: transparent;
  position: relative;
  opacity: 0;
  will-change: transform, opacity;
}

.std-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  opacity: 1;
}

.std-photo.left {
  border-radius: 72px 0 0 0;
  transform: translateY(-80px);
}

.std-photo.right {
  border-radius: 0 0 72px 0;
  transform: translateY(80px);
}

.std-photo.left.in-view {
  animation: stdBoxFromTop 1.8s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
}

.std-photo.right.in-view {
  animation: stdBoxFromBottom 1.8s cubic-bezier(0.25, 0.1, 0.25, 1) 0.12s forwards;
}

@keyframes stdBoxFromTop {
  from { opacity: 0; transform: translateY(-80px); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes stdBoxFromBottom {
  from { opacity: 0; transform: translateY(80px); }
  to   { opacity: 1; transform: translateY(0); }
}

