---
import { wedding } from '../data/wedding';
const w = wedding;
const parentsBride = w.couple.bride.parents.split('\n');
const parentsGroom = w.couple.groom.parents.split('\n');
const giftLines = w.gift.address.lines.split('\n');
---
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{w.meta.title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
  <style define:vars={{
      cream: w.theme.colors.cream,
      soft: w.theme.colors.soft,
      elegant: w.theme.colors.elegant,
      muted: w.theme.colors.muted,
      accent: w.theme.colors.accent,
      accentHover: w.theme.colors.accentHover,
      accentAlt: w.theme.colors.accentAlt,
      accentSoft: w.theme.colors.accentSoft,
      panelSoft: w.theme.colors.panelSoft,
      light: w.theme.colors.light,
    }}>
    :root {
      --cream: var(--cream);
      --soft: var(--soft);
      --elegant: var(--elegant);
      --muted: var(--muted);
      --accent: var(--accent);
      --accent-hover: var(--accentHover);
      --accent-alt: var(--accentAlt);
      --accent-soft: var(--accentSoft);
      --panel-soft: var(--panelSoft);
      --light: var(--light);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: var(--cream);
      color: var(--elegant);
      overflow-x: hidden;
      font-size: 15px;
      line-height: 1.75;
      font-weight: 300;
    }
    .font-serif { font-family: 'Playfair Display', 'Cormorant Garamond', Georgia, serif; }
    .font-corm { font-family: 'Cormorant Garamond', Georgia, serif; }

    /* ========== COVER – SPLIT SCREEN ========== */
#cover {
  position: fixed; inset: 0; z-index: 50;
  display: flex;
  transition: opacity 0.9s ease, visibility 0.9s ease;
}
#cover.hidden { opacity: 0; visibility: hidden; pointer-events: none; }

.cover-panel {
  position: relative;
  flex: 1;
  height: 100%;
  overflow: hidden;
}
.cover-panel .panel-bg {
  position: absolute; inset: 0;
  background-size: cover;
  background-position: center;
  transition: transform 8s ease;
}
.cover-panel:hover .panel-bg { transform: scale(1.04); }

/* Left panel */
.cover-left { flex: 1.15; }
.cover-left .panel-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.15) 40%, transparent 70%);
}
.cover-left .panel-content {
  position: absolute; bottom: 0; left: 0; right: 0;
  padding: 2.5rem 2rem 3rem;
  color: var(--light);
  z-index: 2;
}
.cover-left .label {
  font-size: 10px; letter-spacing: 0.38em; text-transform: uppercase;
  color: rgba(255,255,255,0.85); margin-bottom: 0.6rem; font-weight: 400;
}
.cover-left h1 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2.2rem, 5vw, 3.4rem);
  font-weight: 400; letter-spacing: 0.03em; margin-bottom: 0.5rem;
  line-height: 1.15;
}
.cover-left .date {
  font-size: 12px; letter-spacing: 0.22em; color: rgba(255,255,255,0.8);
}

/* Right panel */
.cover-right { flex: 0.85; }
.cover-right .panel-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(
    180deg,
    rgba(0,0,0,0.15) 0%,
    rgba(0,0,0,0.08) 35%,
    rgba(217,208,196,0.45) 70%,
    rgba(217,208,196,0.88) 88%,
    var(--panel-soft) 100%
  );
}
.cover-right .panel-content {
  position: absolute; inset: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
  text-align: center; padding: 2rem 1.5rem 9.5rem;
  z-index: 2;
}
.cover-right .label {
  font-family: 'Inter', system-ui, sans-serif;
  font-size: 11px; letter-spacing: 0.36em; text-transform: uppercase;
  color: var(--light); margin-bottom: 0.35rem; font-weight: 500;
}
.cover-right h1 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2.4rem, 6.2vw, 3.4rem);
  font-weight: 600; letter-spacing: 0.02em; margin-bottom: 0;
  color: var(--light);
  line-height: 1.12;
}
.cover-right .guest-label {
  font-family: 'Inter', system-ui, sans-serif;
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.9);
  margin-top: 1.25rem;
  margin-bottom: 0.35rem;
  font-weight: 500;
}
.cover-right .guest-name {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(1.35rem, 3.6vw, 1.65rem);
  font-weight: 500;
  font-style: normal;
  color: var(--light);
  letter-spacing: 0.02em;
  margin-bottom: 1.25rem;
  line-height: 1.3;
  max-width: 16rem;
  word-wrap: break-word;
}
.btn-open {
  display: inline-block; padding: 0.8rem 2.1rem;
  background: var(--accent); color: var(--light);
  border: none; letter-spacing: 0.18em; text-transform: uppercase; font-size: 11px;
  cursor: pointer; transition: all 0.35s; font-weight: 400;
  border-radius: 2px;
}
.btn-open:hover { background: var(--accent-hover); transform: translateY(-1px); }

/* Mobile: hanya tampil panel kanan */
@media (max-width: 768px) {
  .cover-left { display: none; }
  .cover-right { flex: 1; width: 100%; }
  .cover-right h1 { font-size: clamp(2.2rem, 9vw, 2.8rem); }
  .cover-right .panel-content { padding-bottom: 7.5rem; }
}


/* ========== MAIN ========== */
#main-content {
  opacity: 0;
  transition: opacity 1.1s ease 0.2s;
}
#main-content.visible {
  opacity: 1;
}

/* ========== DESKTOP SPLIT SCREEN (setelah buka undangan) ========== */
@media (min-width: 992px) {
  #main-content {
    display: flex;
    height: 100vh;
    overflow: hidden;
  }

  .main-left {
    width: 60%;
    height: 100vh;
    position: sticky;
    top: 0;
    flex-shrink: 0;
    overflow: hidden;
  }

  .main-left .bg {
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
  }

  .main-right {
    width: 40%;
    height: 100vh;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
}

/* Mobile tetap full width */
@media (max-width: 991px) {
  .main-left {
    display: none;
  }
  .main-right {
    width: 100%;
  }
}

    /* Animations */
    .aos { opacity: 0; }
    .aos.is-visible.fade-up { animation: fadeUp 1s ease-out forwards; }
    .aos.is-visible.fade-down { animation: fadeDown 1s ease-out forwards; }
    .aos.is-visible.fade-in { animation: fadeIn 0.9s ease-out forwards; }
    .aos.is-visible.zoom-in { animation: zoomIn 0.9s ease-out forwards; }
    .aos.is-visible.fade-left { animation: fadeLeft 1s ease-out forwards; }
    .aos.is-visible.fade-right { animation: fadeRight 1s ease-out forwards; }
    @keyframes fadeUp { from { opacity:0; transform:translateY(48px); } to { opacity:1; transform:translateY(0); } }
    @keyframes fadeDown { from { opacity:0; transform:translateY(-48px); } to { opacity:1; transform:translateY(0); } }
    @keyframes fadeIn { from { opacity:0; } to { opacity:1; } }
    @keyframes zoomIn { from { opacity:0; transform:scale(0.9); } to { opacity:1; transform:scale(1); } }
    @keyframes fadeLeft { from { opacity:0; transform:translateX(-40px); } to { opacity:1; transform:translateX(0); } }
    @keyframes fadeRight { from { opacity:0; transform:translateX(40px); } to { opacity:1; transform:translateX(0); } }
    .d1 { animation-delay: 0.15s; }
    .d2 { animation-delay: 0.3s; }
    .d3 { animation-delay: 0.45s; }
    .d4 { animation-delay: 0.6s; }

    /* Sections */
    .section { padding: 5.5rem 1.5rem; }
    @media (min-width: 768px) { .section { padding: 7rem 1.5rem; } }
    .section-sm { padding: 4rem 1.5rem; }
    .container { max-width: 720px; margin: 0 auto; }
    .container-lg { max-width: 960px; margin: 0 auto; }
    .text-center { text-align: center; }
    .label {
      font-size: 11px; letter-spacing: 0.32em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 0.75rem; font-weight: 400;
    }
.heading {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(1.85rem, 4.5vw, 2.5rem);
  font-weight: 400;
  font-style: italic;
  letter-spacing: 0.03em;
  margin-bottom: 1.5rem;
}
    .body-text { font-size: 14.5px; color: var(--muted); line-height: 1.85; font-weight: 300; }
    .btn {
      display: inline-block; padding: 0.7rem 1.9rem;
      border: 1px solid var(--elegant); color: var(--elegant);
      letter-spacing: 0.18em; text-transform: uppercase; font-size: 10.5px;
      background: transparent; cursor: pointer; transition: all 0.3s;
      text-decoration: none; font-weight: 400;
    }
    .btn:hover { background: var(--elegant); color: var(--cream); }

/* ========== HERO / COUNTDOWN ========== */
.hero {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  text-align: center;
  position: relative;
  overflow: hidden;
  padding-bottom: 6vh;
}
.hero-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  background-size: cover;
  background-position: center 30%;
  transition: opacity 1.8s ease;
}
/* slow horizontal slide track for hero images */
.hero-slide-track {
  position: absolute;
  inset: 0;
  display: flex;
  width: 100%;
  transition: transform 2.2s cubic-bezier(0.25, 0.1, 0.25, 1);
  will-change: transform;
}
.hero-slide-track .hero-bg {
  position: relative;
  flex: 0 0 100%;
  width: 100%;
  height: 100%;
  inset: auto;
}
.hero-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(
    180deg,
    rgba(0,0,0,0.15) 0%,
    rgba(0,0,0,0.08) 35%,
    rgba(217,208,196,0.45) 70%,
    rgba(217,208,196,0.88) 88%,
    var(--panel-soft) 100%
  );
}
.hero-content {
  position: relative;
  z-index: 2;
}
.hero .label {
  color: rgba(255,255,255,0.9) !important;
  text-shadow: 0 1px 8px rgba(0,0,0,0.25);
}
.hero .heading {
  font-family: 'Playfair Display', Georgia, serif !important;
  font-style: normal !important;
  font-weight: 500 !important;
  color: var(--light) !important;
  text-shadow: 0 2px 14px rgba(0,0,0,0.3);
}
.countdown {
  display: flex;
  gap: 0.6rem;
  justify-content: center;
  margin-top: 1rem;
  flex-wrap: wrap;
}

@media (min-width: 768px) {
  .countdown {
    gap: 0.75rem;
  }
}

.cd-item {
  min-width: 5.2rem;              /* lebih lebar → persegi panjang */
  text-align: center;
  background: rgba(255, 255, 255, 0.38);  /* lebih transparan */
  border: none;                   /* hilangkan border */
  border-radius: 12px;
  padding: 0.75rem 1rem 0.6rem;   /* padding horizontal lebih besar */
  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
  backdrop-filter: blur(10px);
}

@media (min-width: 768px) {
  .cd-item {
    min-width: 5.8rem;
    padding: 0.9rem 1.15rem 0.7rem;
  }
}

.cd-num {
  font-family: Inter, system-ui, sans-serif;  /* font simple */
  font-size: clamp(1.15rem, 3.2vw, 1.45rem);
  font-weight: 400;                 /* ringan & clean */
  letter-spacing: 0.02em;
  color: var(--elegant);
  line-height: 1.15;
}

.cd-label {
  font-family: Inter, system-ui, sans-serif;
  font-size: 8.5px;
  letter-spacing: 0.18em;
  text-transform: uppercase;       /* lebih rapi & estetik */
  color: #6b6b6b;
  margin-top: 0.3rem;
  font-weight: 400;
  }
    /* Salam section — soft beige so carousel sits on color boundary */
.salam-section {
  background: var(--panel-soft);
  padding: 2.5rem 1.5rem 0 !important;
  margin-bottom: 0;
  position: relative;
  z-index: 1;
}
.salam-section .container {
  padding-bottom: 2rem;
      }
.salam-section .heading {
  color: var(--light);
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-style: italic;
  font-weight: 400;
  font-size: clamp(1.35rem, 4vw, 1.75rem);
  letter-spacing: 0.04em;
  margin-bottom: 1.5rem;
}
.salam-section .body-text {
  color: rgba(255,255,255,0.92);
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: 14.5px;
  line-height: 1.65;
  font-weight: 400;
  max-width: 32rem;
  margin: 0 auto;
}

    /* custom appear animations */
    @keyframes slideInFromRight {
      from { opacity: 0; transform: translateX(28px) rotate(180deg); }
      to   { opacity: 1; transform: translateX(0) rotate(180deg); }
    }
    @keyframes slideInFromLeft {
      from { opacity: 0; transform: translateX(-28px); }
      to   { opacity: 1; transform: translateX(0); }
    }
    @keyframes slideInFromBottom {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .anim-from-right {
      opacity: 0;
    }
    .anim-from-right.in-view {
      animation: slideInFromRight 0.9s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
    }
    .anim-from-left {
      opacity: 0;
    }
    .anim-from-left.in-view {
      animation: slideInFromLeft 0.9s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
    }
    .anim-from-bottom {
      opacity: 0;
    }
    .anim-from-bottom.in-view {
      animation: slideInFromBottom 0.85s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
    }
    .anim-from-bottom.delay-1 { animation-delay: 0.12s; }
    .anim-from-bottom.delay-2 { animation-delay: 0.24s; }
    .anim-from-bottom.delay-3 { animation-delay: 0.36s; }

    /* ========== BRIDE & GROOM ========== */
    .bg-section {
      background: var(--light);
      position: relative;
      overflow: hidden;
    }

    /* Dedicated Bride & Groom block — forced pure white */
    .bride-groom-section {
      background: var(--light) !important;
      background-color: var(--light) !important;
      position: relative;
      overflow: visible;
      width: 100%;
      margin: 0;
      padding: 0 1.5rem 5.5rem;
      /* lower half of carousel + gap to "Bride & Groom" title */
      padding-top: 8rem;
    }
    .bride-groom-title {
      font-style: italic;
      margin-top: 0.15rem;
      margin-bottom: 1.5rem;
      color: var(--elegant);
    }

/* Circular carousel — tepat 4 lingkaran */
.circle-carousel {
  --circle-size: 78px;
  --circle-gap: 4px;
  width: calc(var(--circle-size) * 4 + var(--circle-gap) * 3); /* = 324px */
  max-width: 90vw;          /* jaga-jaga layar sangat kecil */
  margin: 0 auto;
  position: relative;
  z-index: 5;
  transform: translateY(50%);
  overflow: hidden;
}

/* layar kecil: kecilkan lingkaran supaya tetap pas 4 */
@media (max-width: 380px) {
  .circle-carousel {
    --circle-size: 68px;    /* 68*4 + 4*3 = 284px → muat di HP sempit */
  }
}

.circle-carousel-track {
  display: flex;
  gap: var(--circle-gap);
  transition: transform 1.4s cubic-bezier(0.25, 0.1, 0.25, 1);
  will-change: transform;
}

.circle-carousel-track img {
  width: var(--circle-size);
  height: var(--circle-size);
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
  box-shadow: 0 2px 8px rgba(0,0,0,0.10);
  border: 3px solid var(--light);
  background: var(--light);
  opacity: 1;
}

    /* Person block — fully centered */
    .person-block {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      margin-bottom: 2.25rem;
      width: 100%;
    }
    /* Photo centered; label farther from photo */
    .person-photo-row {
      display: grid;
      grid-template-columns: 40px minmax(0, 1fr) 40px;
      align-items: center;
      column-gap: 14px;
      width: min(420px, 96vw);
      margin: 0 auto 1.35rem;
    }
    .person-photo-row .person-photo { grid-column: 2; justify-self: center; }
    .person-photo-row .bride-label { grid-column: 3; justify-self: start; margin-left: 4px; }
    .person-photo-row .groom-label { grid-column: 1; justify-self: end; margin-right: 4px; }
    .person-photo {
      width: min(320px, 86vw);
      aspect-ratio: 1;
      border-radius: 18px;
      overflow: hidden;
      position: relative;
    }
    /* Bride: thicker & wider shadow right + bottom */
    [data-slider="bride"].person-photo {
      box-shadow:
        10px 12px 14px rgba(0,0,0,0.18),
        20px 24px 32px rgba(0,0,0,0.14),
        36px 42px 56px rgba(0,0,0,0.09),
        52px 60px 88px rgba(0,0,0,0.05);
    }
    /* Groom: thicker & wider shadow left + bottom */
    [data-slider="groom"].person-photo {
      box-shadow:
        -10px 12px 14px rgba(0,0,0,0.18),
        -20px 24px 32px rgba(0,0,0,0.14),
        -36px 42px 56px rgba(0,0,0,0.09),
        -52px 60px 88px rgba(0,0,0,0.05);
    }
    @media (min-width: 768px) {
      .person-photo { width: 340px; }
    }
    .person-photo .slide-track {
      display: flex; height: 100%; width: 100%;
      transition: transform 1.5s cubic-bezier(0.25, 0.1, 0.25, 1);
      will-change: transform;
    }
    .person-photo .slide-track img {
      flex: 0 0 100%; width: 100%; height: 100%; object-fit: cover;
    }

    /* Vertical label — larger & more spaced from photo */
    .person-label {
      writing-mode: vertical-rl;
      text-orientation: mixed;
      font-family: 'Cormorant Garamond', 'Times New Roman', serif;
      font-size: 28px;
      letter-spacing: 0.12em;
      color: var(--accent);
      font-weight: 500;
      white-space: nowrap;
      line-height: 1;
    }
    @media (min-width: 768px) {
      .person-label { font-size: 30px; letter-spacing: 0.14em; }
    }
    .person-label.bride-label { transform: rotate(180deg); }

.person-name {
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 1.55rem;
  font-weight: 400;
  font-style: italic;
  letter-spacing: 0.01em;
  margin-bottom: 0.5rem;
  color: var(--elegant);
}
    .person-parents {
      font-size: 13px;
      color: var(--muted);
      line-height: 1.7;
      margin-bottom: 1rem;
      max-width: 280px;
    }
    .ig-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.5rem 1.2rem;
      border-radius: 999px;
      background: var(--accent-alt);
      color: var(--light);
      font-size: 12.5px;
      text-decoration: none;
      font-weight: 400;
      transition: background 0.25s, transform 0.2s;
      box-shadow: 0 4px 12px rgba(139,115,85,0.25);
    }
    .ig-btn:hover { background: var(--accent-hover); transform: scale(1.03); }
    .ig-btn svg { width: 14px; height: 14px; fill: currentColor; }

    .person-and {
      font-family: 'Cormorant Garamond', serif;
      font-style: italic;
      font-size: 1.5rem;
      color: var(--muted);
      text-align: center;
      margin: 0.25rem 0 2.25rem;
    }

    /* Quote */
    .quote-box {
      max-width: 520px; margin: 2rem auto 0; text-align: center;
      background: transparent;
      padding: 0;
    }
    .quote-text {
      font-family: 'Cormorant Garamond', serif; font-style: italic;
      font-size: 16px;
      color: #4A453F !important;
      line-height: 1.8; margin-bottom: 0.75rem;
    }
    .quote-source {
      font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--accent-alt) !important;
    }

    /* Full-width brown quote band (like reference) */
    .quote-band {
      background: var(--accent-soft);
      padding: 3.25rem 1.5rem 2.25rem;
      text-align: center;
    }
    .quote-band .quote-text {
      color: rgba(255,255,255,0.95) !important;
      max-width: 520px;
      margin: 0 auto 0.85rem;
      font-size: 15.5px;
      line-height: 1.85;
    }
    .quote-band .quote-source {
      color: rgba(255,255,255,0.85) !important;
      letter-spacing: 0.2em;
    }

/* ========== SAVE THE DATE ========== */
.std-section {
  position: relative;
  overflow: visible;
  background: transparent;
  padding: 4rem 0 0;
  text-align: center;
}

/* Wrapper Save the Date + Wedding Event */
.std-we-wrap {
  position: relative;
  overflow: hidden;
  background: var(--light);
}

/* Track slide horizontal (mirip hero) */
.std-slide-track {
  position: absolute;
  inset: 0;
  z-index: 0;
  display: flex;
  width: 100%;
  transition: transform 2.2s cubic-bezier(0.25, 0.1, 0.25, 1);
  will-change: transform;
}

.std-slide-track .std-bg {
  position: relative;
  flex: 0 0 100%;
  width: 100%;
  height: 100%;
  background-size: cover;
